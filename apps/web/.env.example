# Korapay Payment Gateway (Get from https://korapay.com after verification)
ZENDFI_WEBHOOK_SECRET=your_korapay_public_key
ZENDFI_API_KEY=your_korapay_secret_key
KORAPAY_ENCRYPTION_KEY=your_korapay_encryption_key

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

ADMIN_EMAILS=admin@example.com
