# CaseWin AI Environment Variables

# xAI API Key (for Grok AI)
# Get your API key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Korapay Payment Gateway
# Get your keys from: https://korapay.com/
KORAPAY_SECRET_KEY=your_korapay_secret_key
KORAPAY_PUBLIC_KEY=your_korapay_public_key

# Supabase (Database & Auth)
# Get your keys from: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
